# Cenote local configuration. Copy to .env and adjust.

# --- Core paths ---
CENOTE_VAULT_PATH=./fixtures/vault
CENOTE_DB_PATH=./data/cenote.db
CENOTE_VECTOR_PATH=./data/vector
CENOTE_SIDECAR_DIR=.cenote

# --- Local Hive (Ollama) ---
CENOTE_OLLAMA_URL=http://127.0.0.1:11434
CENOTE_OLLAMA_EXTRACT_MODEL=llama3.2:3b
CENOTE_OLLAMA_EMBED_MODEL=nomic-embed-text
CENOTE_OLLAMA_TIMEOUT_MS=60000

# --- Transports ---
CENOTE_HTTP_BIND=127.0.0.1:8787
CENOTE_MCP_TRANSPORT=stdio

# --- Cloud reasoner (optional; kept provider-neutral) ---
CENOTE_CLOUD_PROVIDER=simulator
# CENOTE_CLOUD_URL=
# CENOTE_CLOUD_API_KEY=
# CENOTE_CLOUD_MODEL=

# --- Messaging simulator / OpenClaw ---
CENOTE_OPENCLAW_URL=
CENOTE_OPENCLAW_SHARED_SECRET=

# --- Optional Turso replica ---
# CENOTE_TURSO_URL=
# CENOTE_TURSO_AUTH_TOKEN=

# --- Observability ---
RUST_LOG=cenote=info,tower_http=warn
CENOTE_DEBUG_RAW_LOGS=false
